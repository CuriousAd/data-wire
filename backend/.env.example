# LLM — Google Gemini API Keys (5 keys for round-robin rate limit distribution)
# Get free keys at https://aistudio.google.com/ → "Get API Key"
GEMINI_API_KEY_1=your_gemini_api_key_1
GEMINI_API_KEY_2=your_gemini_api_key_2
GEMINI_API_KEY_3=your_gemini_api_key_3
GEMINI_API_KEY_4=your_gemini_api_key_4
GEMINI_API_KEY_5=your_gemini_api_key_5

# Postgres
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Upstash Redis
# (Note: Using 'rediss://' here because Upstash requires TLS)
REDIS_URL=rediss://default:token@host:port

# NewsData
NEWSDATA_API_KEY=your_newsdata_api_key

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173
